# Copy to .env and fill in keys:  cp .env.example .env

# App
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Postgres (dev: docker compose exposes it on localhost:5433)
POSTGRES_DB=lifecoach
POSTGRES_USER=lifecoach
POSTGRES_PASSWORD=lifecoach
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM providers: LLM_PRIMARY is tried first, the other is the automatic fallback
LLM_PRIMARY=mistral
MISTRAL_API_KEY=
GEMINI_API_KEY=
LLM_REPLY_MODEL=mistral-large-latest
LLM_FAST_MODEL=mistral-small-latest
LLM_FALLBACK_MODEL=gemini-2.5-flash
LLM_FALLBACK_FAST_MODEL=gemini-2.5-flash-lite
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed

# Reranker: local | none
RERANKER_PROVIDER=local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
